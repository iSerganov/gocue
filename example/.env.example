# Copy to .env and edit. .env is git-ignored; never commit it.
#   cp example/.env.example example/.env

# Absolute path on YOUR machine to the folder holding the audio files.
# Mounted read-only at /music inside the container. Required.
MUSIC_DIR=/absolute/path/to/your/audio/folder

# Icecast. Change the passwords before exposing this anywhere.
ICECAST_PUBLIC_PORT=8000
ICECAST_SOURCE_PASSWORD=change-me
ICECAST_RELAY_PASSWORD=change-me
ICECAST_ADMIN_PASSWORD=change-me
ICECAST_ADMIN_USERNAME=admin
ICECAST_ADMIN_EMAIL=admin@example.invalid
ICECAST_HOSTNAME=localhost
ICECAST_MOUNT=/radio.ogg

# Station identity, shown on the Icecast status page and in the stream.
STATION_NAME="gocue example radio"
STATION_DESCRIPTION="Autocue points and EBU R128 loudness by gocue"
STATION_GENRE="Oldies"
STATION_URL=https://github.com/iSerganov/gocue

# Control endpoints (/metadata, /health, /skip) on the host.
STATION_HARBOR_PORT=8080

# Version string baked into the gocue binary.
GOCUE_VERSION=dev

# gocue analysis knobs. Each maps to a gocue flag; see the table in the README.
GOCUE_TARGET=-18.0
GOCUE_SILENCE=-42.0
GOCUE_OVERLAY=-8.0
GOCUE_LONGTAIL=15.0
GOCUE_EXTRA=-12.0
GOCUE_DROP=40.0
GOCUE_BLANKSKIP=0.0
GOCUE_FADE_IN=2.0
GOCUE_FADE_OUT=4.0
GOCUE_NOCLIP=true
GOCUE_TIMEOUT=120.0

# Longest crossfade to impose when a track ends cold, in seconds.
STATION_MAX_CROSS=4.0
